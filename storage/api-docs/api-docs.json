{
    "openapi": "3.0.0",
    "info": {
        "title": "Kakusin API",
        "description": "Tài liệu API Kakusin",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local API Server"
        }
    ],
    "paths": {
        "/api/banners": {
            "get": {
                "tags": [
                    "Banners"
                ],
                "summary": "Lấy danh sách Banners",
                "operationId": "25be441ec44a17512296339ef48da34c",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Mã ngôn ngữ (vi, ja, en). Mặc định là 'vi'",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "vi"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    },
                    "500": {
                        "description": "Lỗi server"
                    }
                }
            }
        },
        "/api/news": {
            "get": {
                "tags": [
                    "News"
                ],
                "summary": "Lấy danh sách tin tức (News)",
                "operationId": "9bfe744cf19dcb58e9ab9677c29ee6c7",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "query",
                        "description": "Mã ngôn ngữ (vi, ja, en). Mặc định là 'vi'",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "vi"
                        }
                    },
                    {
                        "name": "featured",
                        "in": "query",
                        "description": "Lọc theo bài viết nổi bật (truyền true để lọc)",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "description": "Lọc theo danh mục (slug: press-release, event, insight)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 21
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "ソフトウェアエンジニアのためのClean Architecture入門"
                                                    },
                                                    "subtitle": {
                                                        "type": "string",
                                                        "example": "MASTERING PROFESSIONAL DEVELOPMENT"
                                                    },
                                                    "image": {
                                                        "type": "string",
                                                        "example": "http://localhost:8080/wp-content/uploads/2026/06/1-1.jpg"
                                                    },
                                                    "link": {
                                                        "type": "string",
                                                        "example": "https://dev-blog.example.com/clean-architecture"
                                                    },
                                                    "is_featured": {
                                                        "type": "boolean",
                                                        "example": true
                                                    },
                                                    "slug": {
                                                        "type": "string",
                                                        "example": "ソフトウェアエンジニアのためのclean-architecture入門"
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "example": "2026.06.26"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Lỗi server"
                    }
                }
            }
        }
    },
