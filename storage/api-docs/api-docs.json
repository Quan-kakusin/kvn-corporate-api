                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "category": {
                        "type": "string",
                        "example": "Tư vấn dịch vụ"
                    },
                    "name": {
                        "type": "string",
                        "example": "Trần Anh Quân"
                    },
                    "company": {
                        "type": "string",
                        "example": "Kakusin"
                    },
                    "email": {
                        "type": "string",
                        "example": "quan@example.com"
                    },
                    "phone": {
                        "type": "string",
                        "example": "0901234567",
                        "nullable": true
                    },
                    "content": {
                        "type": "string",
                        "example": "Tôi cần tư vấn chi tiết..."
                    },
                    "agree": {
                        "type": "boolean",
