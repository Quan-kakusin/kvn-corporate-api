{
    "openapi": "3.0.0",
    "info": {
        "title": "Kakusin API",
        "description": "Tài liệu API Kakusin",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://kakusinvn.duckdns.org",
            "description": "API Server"
        }
    ],
    "paths": {
        "/api/contact": {
            "post": {
                "tags": [
                    "Contact"
                ],
                "summary": "Obtain contact information and send notification emails.",
                "operationId": "9eda9ed95afbd9946c93c6caba6b8ff2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "category",
                                    "name",
                                    "email",
                                    "content",
                                    "agree"
                                ],
                                "properties": {
                                    "category": {
                                        "type": "string",
                                        "example": "Hỗ trợ kỹ thuật"
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Trần Anh Quân"
                                    },
                                    "company": {
                                        "type": "string",
                                        "example": "Công ty Kakusin"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "quan@example.com"
                                    },
                                    "content": {
                                        "type": "string",
                                        "example": "Nội dung cần liên hệ..."
                                    },
                                    "agree": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Gửi liên hệ thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Contact information has been successfully submitted."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Gửi quá giới hạn cho phép",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "error"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Bạn đã đạt giới hạn gửi liên hệ trong ngày. Vui lòng thử lại vào ngày mai."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/news": {
            "get": {
                "tags": [
                    "News"
                ],
                "summary": "Danh sách News (Tổng)",
                "operationId": "a03e1a336bc332d11c385fe176757db9",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "ja"
                        }
                    },
                    {
                        "name": "featured",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    }
                }
            }
        },
        "/api/news/categories": {
            "get": {
                "tags": [
                    "News"
                ],
                "summary": "Danh sách Category kèm số lượng bài viết",
                "operationId": "74b5815d00afa7564e2a3b25744c0668",
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    }
                }
            }
        },
        "/api/news/{slug}": {
            "get": {
                "tags": [
                    "News"
                ],
                "summary": "Chi tiết News",
                "operationId": "ba93f1c65324d8a38ae2227d5ac93caf",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "locale",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "ja"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    },
                    "404": {
                        "description": "Không tìm thấy bài viết"
                    }
                }
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Danh sách Product (Tổng/Phân trang)",
                "operationId": "d97d1c3727cbac49708b85f7d11f7d58",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "ja"
                        }
                    },
                    {
                        "name": "featured",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "all"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    }
                }
            }
        },
        "/api/products/{slug}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Chi tiết Product",
                "operationId": "5bbb6d725346d38781b256ed5c715d62",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "locale",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "ja"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu chi tiết thành công"
                    },
                    "404": {
                        "description": "Không tìm thấy sản phẩm"
                    }
                }
            }
        },
        "/api/seo/pages": {
            "get": {
                "tags": [
                    "SEO"
                ],
                "summary": "Lấy cấu hình SEO đa ngôn ngữ của trang tĩnh",
                "operationId": "134ddcdc4d4cc55577f117dee2b39e4b",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "ja",
                            "enum": [
                                "ja",
                                "vi",
                                "en"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu SEO thành công"
                    }
                }
            }
        },
        "/api/services": {
            "get": {
                "tags": [
                    "Services"
                ],
                "summary": "Danh sách Services",
                "operationId": "97de511018def32ca0ccbc800756c538",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "ja"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    }
                }
            }
        },
        "/api/subscriber": {
            "post": {
                "tags": [
                    "Subscriber"
                ],
                "summary": "Đăng ký nhận bản tin (Newsletter)",
                "operationId": "b73d85ff05699b1f085da330d936b25d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@example.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Đăng ký thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "You have successfully subscribed to our newsletter."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Dữ liệu không hợp lệ (email đã tồn tại hoặc sai định dạng)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "This email is already subscribed."
                                        },
                                        "errors": {
                                            "properties": {
                                                "email": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "This email is already subscribed."
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/webhook/new-post": {
            "post": {
                "tags": [
                    "Webhook"
                ],
                "summary": "Webhook nhận thông báo bài viết mới từ WordPress",
                "operationId": "9d3ee15e2655b4ef808c5620d44416b3",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Tiêu đề bài viết mới"
                                    },
                                    "link": {
                                        "type": "string",
                                        "example": "https://example.com/news/article-1"
                                    },
                                    "image": {
                                        "type": "string",
                                        "example": "https://example.com/image.jpg"
                                    },
                                    "subtitle": {
                                        "type": "string",
                                        "example": "Mô tả ngắn gọn về bài viết"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Gửi thông báo thành công cho danh sách subscribers",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Notifications sent to subscribers."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Lỗi server khi gửi mail",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Server Error"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Contact": {
                "title": "Contact",
                "description": "Thông tin liên hệ từ khách hàng",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "category": {
                        "type": "string",
                        "example": "Tư vấn dịch vụ"
                    },
                    "name": {
                        "type": "string",
                        "example": "Trần Anh Quân"
                    },
                    "company": {
                        "type": "string",
                        "example": "Kakusin"
                    },
                    "email": {
                        "type": "string",
                        "example": "quan@example.com"
                    },
                    "phone": {
                        "type": "string",
                        "example": "0901234567",
                        "nullable": true
                    },
                    "content": {
                        "type": "string",
                        "example": "Tôi cần tư vấn chi tiết..."
                    },
                    "agree": {
                        "type": "boolean",
                        "example": true
                    },
                    "is_read": {
                        "type": "boolean",
                        "example": false
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Subscriber": {
                "title": "Subscriber",
                "description": "Model đăng ký nhận bản tin",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "WpPost": {
                "title": "WpPost",
                "description": "Model tương tác với bảng wp_posts của WordPress",
                "properties": {
                    "ID": {
                        "type": "integer",
                        "example": 9
                    },
                    "post_author": {
                        "type": "integer",
                        "example": 1
                    },
                    "post_date": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "post_title": {
                        "type": "string",
                        "example": "Tiêu đề bài viết WP"
                    },
                    "post_content": {
                        "type": "string",
                        "example": "Nội dung bài viết..."
                    },
                    "post_status": {
                        "type": "string",
                        "example": "publish"
                    },
                    "post_type": {
                        "type": "string",
                        "example": "home_banner"
                    }
                },
                "type": "object"
            },
            "WpPostMeta": {
                "title": "WpPostMeta",
                "description": "Model lưu dữ liệu ACF và Meta của WordPress",
                "properties": {
                    "meta_id": {
                        "type": "integer",
                        "example": 100
                    },
                    "post_id": {
                        "type": "integer",
                        "example": 9
                    },
                    "meta_key": {
                        "type": "string",
                        "example": "banner_subtitle"
                    },
                    "meta_value": {
                        "type": "string",
                        "example": "INNOVATION THROUGH DIGITAL"
                    }
                },
                "type": "object"
            }
        }
    },
