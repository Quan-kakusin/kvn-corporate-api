{
    "openapi": "3.0.0",
    "info": {
        "title": "Kakusin API",
        "description": "Tài liệu API Kakusin",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "API Server"
        }
    ],
    "paths": {
        "/api/banners": {
            "get": {
                "tags": [
                    "Banners"
                ],
                "summary": "Lấy danh sách Banners",
                "operationId": "25be441ec44a17512296339ef48da34c",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Mã ngôn ngữ (vi, ja, en). Mặc định là 'vi'",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "vi"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    },
                    "500": {
                        "description": "Lỗi server"
                    }
                }
            }
        },
        "/api/contact": {
            "post": {
                "tags": [
                    "Contact"
                ],
                "summary": "Obtain contact information and send notification emails.",
                "operationId": "23d287b7052bd07a4c20670cbb41dcc1",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "category",
                                    "name",
                                    "email",
                                    "content",
                                    "agree"
                                ],
                                "properties": {
                                    "category": {
                                        "type": "string",
                                        "example": "Hỗ trợ kỹ thuật"
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Trần Anh Quân"
                                    },
                                    "company": {
                                        "type": "string",
                                        "example": "Công ty Kakusin"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "quan@example.com"
                                    },
                                    "content": {
                                        "type": "string",
                                        "example": "Nội dung cần liên hệ..."
                                    },
                                    "agree": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Gửi liên hệ thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Contact information has been successfully submitted."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Gửi quá giới hạn cho phép",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "error"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Bạn đã đạt giới hạn gửi liên hệ trong ngày. Vui lòng thử lại vào ngày mai."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/news": {
            "get": {
                "tags": [
                    "News"
                ],
                "summary": "Danh sách News (Tổng)",
                "operationId": "9bfe744cf19dcb58e9ab9677c29ee6c7",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "ja"
                        }
                    },
                    {
                        "name": "featured",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    }
                }
            }
        },
        "/api/news/categories": {
            "get": {
                "tags": [
                    "News"
                ],
                "summary": "Danh sách Category kèm số lượng bài viết",
                "operationId": "fa1156a0f925e9414e8f286f4e9291ad",
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    }
                }
            }
        },
        "/api/news/{slug}": {
            "get": {
                "tags": [
                    "News"
                ],
                "summary": "Chi tiết News",
                "operationId": "6f16ebaf3fe9643317a035fba8c160ea",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "locale",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "ja"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    },
                    "404": {
                        "description": "Không tìm thấy bài viết"
                    }
                }
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Danh sách Product (Tổng/Phân trang)",
                "operationId": "1bfaa78d1c2c3848ab8165c5dadcad3e",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "ja"
                        }
                    },
                    {
                        "name": "featured",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "all"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    }
                }
            }
        },
        "/api/products/{slug}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Chi tiết Product",
                "operationId": "2eb94cf22f00aa181040441a8ae7b07e",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "locale",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "ja"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu chi tiết thành công"
                    },
                    "404": {
                        "description": "Không tìm thấy sản phẩm"
                    }
                }
            }
        },
        "/api/services": {
            "get": {
                "tags": [
                    "Services"
                ],
                "summary": "Danh sách Services",
                "operationId": "4c175c5d6594b4a5112bbe15a46e2bb4",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "ja"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lấy dữ liệu thành công"
                    }
                }
            }
        },
        "/api/subscriber": {
            "post": {
                "tags": [
                    "Subscriber"
                ],
                "summary": "Đăng ký nhận bản tin (Newsletter)",
                "operationId": "ed25c502bbedb28f0c7ae29d43420cc1",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@example.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Đăng ký thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "You have successfully subscribed to our newsletter."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Dữ liệu không hợp lệ (email đã tồn tại hoặc sai định dạng)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "This email is already subscribed."
                                        },
                                        "errors": {
                                            "properties": {
                                                "email": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "This email is already subscribed."
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/webhook/new-post": {
            "post": {
                "tags": [
                    "Webhook"
                ],
                "summary": "Webhook nhận thông báo bài viết mới từ WordPress",
                "operationId": "f45dfbd0419198df912683a4259508f9",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Tiêu đề bài viết mới"
                                    },
                                    "link": {
                                        "type": "string",
                                        "example": "https://example.com/news/article-1"
                                    },
                                    "image": {
                                        "type": "string",
                                        "example": "https://example.com/image.jpg"
                                    },
                                    "subtitle": {
                                        "type": "string",
                                        "example": "Mô tả ngắn gọn về bài viết"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Gửi thông báo thành công cho danh sách subscribers",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Notifications sent to subscribers."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Lỗi server khi gửi mail",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Server Error"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
